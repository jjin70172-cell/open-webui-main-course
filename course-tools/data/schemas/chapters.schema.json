{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Course Chapters",
  "description": "28 learning units ordered by labs/index.md. No question-bank fields are allowed.",
  "type": "object",
  "required": ["schema_version", "repository", "source_commit", "chapters"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "repository": {"type": "string"},
    "source_commit": {"type": "string"},
    "index_definition": {"type": "object"},
    "chapters": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {"$ref": "#/definitions/chapter"}
    }
  },
  "definitions": {
    "chapter": {
      "type": "object",
      "required": [
        "id",
        "lab_no",
        "title",
        "aliases",
        "category",
        "pattern_kind",
        "summary",
        "keywords",
        "knowledge_points",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "lab_no": {"type": "integer", "minimum": 1, "maximum": 28},
        "title": {
          "type": "object",
          "required": ["en", "zh"],
          "additionalProperties": false,
          "properties": {
            "en": {"type": "string"},
            "zh": {"type": "string"}
          }
        },
        "aliases": {"type": "array", "items": {"type": "string"}},
        "category": {"enum": ["behavioral", "creational", "structural"]},
        "pattern_kind": {"enum": ["gof", "python_idiom", "architecture"]},
        "summary": {"type": "string"},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "knowledge_points": {
          "type": "array",
          "items": {"$ref": "#/definitions/knowledge_point"}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/source"}
        }
      }
    },
    "knowledge_point": {
      "type": "object",
      "required": ["id", "type", "text", "source_files", "evidence", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {
          "enum": ["pattern_role", "python_technique", "lab_task", "pitfall", "comparison"]
        },
        "text": {"type": "string"},
        "source_files": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "string"},
        "confidence": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": ["path", "type"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "type": {"type": "string"}
      }
    }
  }
}

